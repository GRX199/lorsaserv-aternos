# ==========================================
# KONFIGURASI DISCORD BOT (RAHASIA)
# ==========================================

# Token bot dari Discord Developer Portal (Menu "Bot" -> "Reset Token")
DISCORD_TOKEN=MASUKKAN_TOKEN_BOT_DISCORD_ANDA_DI_SINI

# Application ID bot dari Discord Developer Portal (Menu "General Information")
CLIENT_ID=MASUKKAN_CLIENT_ID_BOT_DI_SINI

# (Opsional) ID Server Discord tempat bot diuji coba (untuk registrasi command instan)
# Jika dikosongkan, slash commands akan didaftarkan secara global (bisa butuh waktu sinkronisasi)
GUILD_ID=

# ID Channel tempat Live Status Panel akan dikirim dan di-update otomatis setiap menit
STATUS_CHANNEL_ID=MASUKKAN_ID_CHANNEL_STATUS

# (Opsional) ID Voice/Text Channel yang namanya akan otomatis berganti sesuai jumlah pemain
# Contoh nama channel otomatis: 🟢・3/20-online atau 🔴・offline
PLAYER_COUNT_CHANNEL_ID=

# (Opsional) ID Channel tempat log server realtime akan distreaming
LOG_CHANNEL_ID=

# (Opsional) ID Channel tempat pesan chat Discord diteruskan langsung ke in-game chat Minecraft
CHAT_BRIDGE_CHANNEL_ID=

# Port untuk Web Healthcheck (Wajib untuk hosting di Render agar tidak mati)
PORT=3000
